POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=

MODEL_PATH=ml_engine/model.pkl
METRICS_PATH=ml_engine/metrics.json
